# Driver database: "sqlite" (default) atau "supabase"
DB_DRIVER=sqlite

# "production" → template Eta di-cache (butuh restart setelah ubah view)
NODE_ENV=development

# Origin yang diizinkan untuk CSRF (sesuaikan saat deploy)
CSRF_ORIGIN=http://localhost:3000

# Base URL publik. Cookie `sid` otomatis pakai `secure` jika diawali https://
APP_URL=http://localhost:3000

# --- SQLite (default) ---
DB_FILE=data/app.db

# --- Supabase (aktif saat DB_DRIVER=supabase) ---
# 1. bun add @supabase/supabase-js
# 2. isi nilai di bawah & apply migrasi supabase/migrations/001_init.sql di Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
